{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ax/business-module/1","type":"object","additionalProperties":false,
"required":["schema","id","version","group","scopes","makers","reviewers","records","gates","panels"],
"properties":{"schema":{"const":1},"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,30}$"},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
"group":{"enum":["direction","market","money","customer","protection"]},
"scopes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["company","service"]}},
"makers":{"$ref":"#/$defs/actors"},"reviewers":{"$ref":"#/$defs/actors"},
"records":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"}},
"gates":{"type":"object","propertyNames":{"enum":["discover","define","build","release","operate","retire"]},"additionalProperties":{"type":"array","minItems":1,"items":{"type":"string"}}},
"approvals":{"type":"array","uniqueItems":true,"items":{"enum":["message.send","ads.spend","price.change","legal.publish","brand.publish","trademark.file","refund.issue"]}},
"panels":{"type":"array","items":{"type":"object","additionalProperties":false,
"required":["id","question","metric","unit","basis","source","max_age_hours","next_action"],
"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"},"question":{"type":"string","minLength":1},"metric":{"type":"string","pattern":"^[a-z][a-z0-9_.]+$"},"unit":{"type":"string","minLength":1},
"basis":{"enum":["actual","forecast","simulated"]},"source":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"max_age_hours":{"type":"integer","minimum":1},"min_sample":{"type":"integer","minimum":1},"counter_metric":{"type":"string"},"next_action":{"type":"string","minLength":1}}}}},
"$defs":{"actors":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(A(0[1-9]|1[0-6])|code|founder|expert)$"}}}}
