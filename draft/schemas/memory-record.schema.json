{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ax/memory-record/1","type":"object","additionalProperties":false,
"required":["schema","id","scope","kind","status","trust","sensitivity","title","body","source"],
"properties":{"schema":{"const":1},"id":{"type":"string","pattern":"^mem_[0-9A-HJKMNP-TV-Z]{26}$"},
"scope":{"enum":["project","global"]},"project_id":{"type":"string"},
"kind":{"enum":["decision","lesson","runbook","instinct","checkpoint"]},
"status":{"enum":["quarantined","candidate","active","superseded","retired"]},
"trust":{"enum":["founder","verified","agent","external"]},
"sensitivity":{"enum":["public","internal","confidential"]},
"title":{"type":"string","minLength":5,"maxLength":120},"body":{"type":"string","minLength":1,"maxLength":8000},
"supersedes":{"type":"string"},"valid_until":{"type":"integer"},
"trigger":{"type":"string","maxLength":300},"action":{"type":"string","maxLength":600},
"source":{"type":"object","additionalProperties":false,"required":["task_id","harness","refs"],
 "properties":{"task_id":{"type":"string"},"harness":{"enum":["claude","codex","gemini","cursor","founder"]},
 "refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^(commit|ci|file|event|approval):.+"}}}}},
"allOf":[{"if":{"properties":{"scope":{"const":"project"}}},"then":{"required":["project_id"]},"else":{"not":{"required":["project_id"]}}},
{"if":{"properties":{"kind":{"const":"instinct"}}},"then":{"required":["trigger","action"]}},
{"if":{"properties":{"trust":{"const":"external"}}},"then":{"properties":{"status":{"enum":["quarantined","retired"]}}}}]}
