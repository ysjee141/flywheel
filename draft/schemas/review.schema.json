{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ax/review/1","type":"object","additionalProperties":false,
"required":["schema","task_id","head_sha","reviewer","verdict","checked","findings"],
"properties":{"schema":{"const":1},"task_id":{"type":"string"},"head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
"reviewer":{"type":"object","required":["vendor","model","session_id"],"properties":{"vendor":{"type":"string"},"model":{"type":"string"},"session_id":{"type":"string"}}},
"verdict":{"enum":["pass","fail","inconclusive"]},
"checked":{"type":"array","minItems":1,"items":{"type":"object","required":["criterion","result","evidence"],"properties":{"criterion":{"type":"string"},"result":{"enum":["pass","fail","not_checked"]},"evidence":{"type":"string","minLength":1}}}},
"findings":{"type":"array","items":{"type":"object","required":["severity","file","line","claim","reproduction"],"properties":{"severity":{"enum":["critical","high","medium","low"]},"file":{"type":"string"},"line":{"type":"integer","minimum":1},"claim":{"type":"string"},"reproduction":{"type":"string"}}}}},
"if":{"properties":{"verdict":{"const":"pass"}}},"then":{"properties":{"findings":{"not":{"contains":{"properties":{"severity":{"enum":["critical","high"]}},"required":["severity"]}}},"checked":{"items":{"properties":{"result":{"const":"pass"}}}}}}}
